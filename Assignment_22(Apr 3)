## 11. frontend/src/components/ProductForm.js
```js
import React, { useState, useEffect } from 'react';

const empty = { name: '', price: '', category: '' };

export default function ProductForm({ onSubmit, editing, onCancel }) {
  const [form, setForm] = useState(empty);

  useEffect(() => {
    setForm(editing ? { name: editing.name, price: editing.price, category: editing.category } : empty);
  }, [editing]);

  const handle = e => setForm({ ...form, [e.target.name]: e.target.value });

  const submit = e => {
    e.preventDefault();
    onSubmit(form);
    setForm(empty);
  };

  return (
    <form onSubmit={submit} style={{ marginBottom: 24 }}>
      <h3>{editing ? 'Edit Product' : 'Add Product'}</h3>
      <input name="name"     placeholder="Name"     value={form.name}     onChange={handle} required />
      <input name="price"    placeholder="Price"    value={form.price}    onChange={handle} required type="number" />
      <input name="category" placeholder="Category" value={form.category} onChange={handle} />
      <button type="submit">{editing ? 'Update' : 'Add'}</button>
      {editing && <button type="button" onClick={onCancel} style={{ marginLeft: 8 }}>Cancel</button>}
    </form>
  );
}
```

