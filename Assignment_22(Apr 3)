## 10. frontend/src/App.js
```js
import React, { useState, useEffect } from 'react';
import ProductForm from './components/ProductForm';
import ProductList from './components/ProductList';
import { getProducts, createProduct, updateProduct, deleteProduct } from './api';

export default function App() {
  const [products, setProducts] = useState([]);
  const [editing, setEditing]   = useState(null);

  const fetchAll = async () => {
    const { data } = await getProducts();
    setProducts(data);
  };

  useEffect(() => { fetchAll(); }, []);

  const handleSubmit = async (form) => {
    if (editing) {
      await updateProduct(editing._id, form);
      setEditing(null);
    } else {
      await createProduct(form);
    }
    fetchAll();
  };

  const handleDelete = async (id) => {
    await deleteProduct(id);
    fetchAll();
  };

  return (
    <div style={{ maxWidth: 800, margin: '40px auto', fontFamily: 'sans-serif', padding: '0 16px' }}>
      <h2>CRUD Lab — Products</h2>
      <ProductForm onSubmit={handleSubmit} editing={editing} onCancel={() => setEditing(null)} />
      <ProductList products={products} onEdit={setEditing} onDelete={handleDelete} />
    </div>
  );
}
```

