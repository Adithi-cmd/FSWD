## 10. frontend/src/App.js
```js
import React, { useState, useEffect } from 'react';
import { login, register, getProducts, createProduct, deleteProduct } from './api';

export default function App() {
  const [token, setToken]       = useState(localStorage.getItem('token'));
  const [role, setRole]         = useState(localStorage.getItem('role'));
  const [products, setProducts] = useState([]);
  const [form, setForm]         = useState({ username: '', password: '', role: 'user' });
  const [newProduct, setNewProduct] = useState({ name: '', price: '', category: '' });
  const [error, setError]       = useState('');

  const fetchProducts = async () => {
    try {
      const { data } = await getProducts();
      setProducts(data);
    } catch (err) {
      setError(err.response?.data?.error || 'Failed to fetch');
    }
  };

  useEffect(() => { if (token) fetchProducts(); }, [token]);

  const handleAuth = async (type) => {
    try {
      setError('');
      const fn = type === 'login' ? login : register;
      const { data } = await fn(form);
      if (type === 'login') {
        localStorage.setItem('token', data.token);
        localStorage.setItem('role', data.role);
        setToken(data.token);
        setRole(data.role);
      } else {
        alert('Registered! Now login.');
      }
    } catch (err) {
      setError(err.response?.data?.error || 'Error');
    }
  };

  const handleLogout = () => {
    localStorage.clear();
    setToken(null); setRole(null); setProducts([]);
  };

  const handleCreate = async () => {
    try {
      await createProduct(newProduct);
      setNewProduct({ name: '', price: '', category: '' });
      fetchProducts();
    } catch (err) {
      setError(err.response?.data?.error || 'Error');
    }
  };

  const handleDelete = async (id) => {
    try {
      await deleteProduct(id);
      fetchProducts();
    } catch (err) {
      setError(err.response?.data?.error || 'Error');
    }
  };

  if (!token) return (
    <div style={{ maxWidth: 400, margin: '60px auto', fontFamily: 'sans-serif' }}>
      <h2>Role Guard</h2>
      {error && <p style={{ color: 'red' }}>{error}</p>}
      <input placeholder="Username" value={form.username}
        onChange={e => setForm({ ...form, username: e.target.value })} /><br /><br />
      <input placeholder="Password" type="password" value={form.password}
        onChange={e => setForm({ ...form, password: e.target.value })} /><br /><br />
      <select value={form.role} onChange={e => setForm({ ...form, role: e.target.value })}>
        <option value="user">User</option>
        <option value="admin">Admin</option>
      </select><br /><br />
      <button onClick={() => handleAuth('login')}>Login</button>
      <button onClick={() => handleAuth('register')} style={{ marginLeft: 8 }}>Register</button>
    </div>
  );

  return (
    <div style={{ maxWidth: 800, margin: '40px auto', fontFamily: 'sans-serif', padding: '0 16px' }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
        <h2>Role Guard — Products</h2>
        <div>
          <span style={{ marginRight: 12 }}>Role: <strong>{role}</strong></span>
          <button onClick={handleLogout}>Logout</button>
        </div>
      </div>

      {error && <p style={{ color: 'red' }}>{error}</p>}

      {role === 'admin' && (
        <div style={{ marginBottom: 24, padding: 16, border: '1px solid #ccc' }}>
          <h4>Add Product (Admin Only)</h4>
          <input placeholder="Name"     value={newProduct.name}
            onChange={e => setNewProduct({ ...newProduct, name: e.target.value })} />
          <input placeholder="Price"    value={newProduct.price} type="number"
            onChange={e => setNewProduct({ ...newProduct, price: e.target.value })} />
          <input placeholder="Category" value={newProduct.category}
            onChange={e => setNewProduct({ ...newProduct, category: e.target.value })} />
          <button onClick={handleCreate} style={{ marginLeft: 8 }}>Add</button>
        </div>
      )}

      <table border="1" cellPadding="8" style={{ width: '100%', borderCollapse: 'collapse' }}>
        <thead>
          <tr><th>Name</th><th>Price</th><th>Category</th>{role === 'admin' && <th>Actions</th>}</tr>
        </thead>
        <tbody>
          {products.map(p => (
            <tr key={p._id}>
              <td>{p.name}</td>
              <td>₹{p.price}</td>
              <td>{p.category}</td>
              {role === 'admin' && (
                <td><button onClick={() => handleDelete(p._id)}>Delete</button></td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
```

