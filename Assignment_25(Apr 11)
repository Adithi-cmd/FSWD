## 13. frontend/src/App.js
```js
import React, { useState } from 'react';
import useItems from './hooks/useItems';
import ItemForm from './components/ItemForm';
import ItemList from './components/ItemList';

export default function App() {
  const { items, loading, error, add, edit, remove } = useItems();
  const [editing, setEditing] = useState(null);

  const handleSubmit = async (form) => {
    if (editing) {
      await edit(editing._id, form);
      setEditing(null);
    } else {
      await add(form);
    }
  };

  return (
    <div style={{ maxWidth: 800, margin: '40px auto', fontFamily: 'sans-serif', padding: '0 16px' }}>
      <h2>Connect the Stack</h2>
      {error && <p style={{ color: 'red' }}>{error}</p>}
      <ItemForm onSubmit={handleSubmit} editing={editing} onCancel={() => setEditing(null)} />
      {loading ? <p>Loading...</p> : <ItemList items={items} onEdit={setEditing} onDelete={remove} />}
    </div>
  );
}
```

